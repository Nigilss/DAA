
# PRACTICAL 4(a): Create a tree and display its elements

tree = []

n = int(input("Enter number of elements: "))

print("Enter the elements:")

for i in range(n):
    x = int(input())
    tree.append(x)

print("\nTree elements are:")

for i in range(n):
    print(tree[i], end=" ")

print("\n")


# PRACTICAL 4(b): Construct a Binary Tree

tree = {}

n = int(input("Enter number of nodes: "))

for i in range(n):
    value = int(input("Enter node value: "))
    tree[value] = [None, None]

print("\nEnter the children of each node.")
print("Enter -1 if there is no child.")

for value in tree:
    left = int(input("Enter left child of " + str(value) + ": "))
    right = int(input("Enter right child of " + str(value) + ": "))

    if left != -1:
        tree[value][0] = left

    if right != -1:
        tree[value][1] = right

print("\nBinary Tree:")

for value in tree:
    print("Node", value,
          "-> Left:", tree[value][0],
          "Right:", tree[value][1])


# PRACTICAL 4(c): Inorder, Preorder and Postorder Traversal

tree = [10, 20, 30, 40, 50]
n = len(tree)

# PREORDER: Root -> Left -> Right

stack = [0]

print("\nPreorder:", end=" ")

while len(stack) > 0:
    i = stack.pop()

    if i < n:
        print(tree[i], end=" ")

        right = 2 * i + 2
        if right < n:
            stack.append(right)

        left = 2 * i + 1
        if left < n:
            stack.append(left)

print()

# INORDER: Left -> Root -> Right

stack = []
i = 0

print("Inorder:", end=" ")

while len(stack) > 0 or i < n:
    while i < n:
        stack.append(i)
        i = 2 * i + 1

    i = stack.pop()

    print(tree[i], end=" ")

    i = 2 * i + 2

print()

# POSTORDER: Left -> Right -> Root

stack1 = [0]
stack2 = []

while len(stack1) > 0:
    i = stack1.pop()

    if i < n:
        stack2.append(i)

        left = 2 * i + 1
        if left < n:
            stack1.append(left)

        right = 2 * i + 2
        if right < n:
            stack1.append(right)

print("Postorder:", end=" ")

while len(stack2) > 0:
    i = stack2.pop()
    print(tree[i], end=" ")

print()
