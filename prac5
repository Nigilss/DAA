# PRACTICAL 5(a): Insertion Sort

a = [64, 25, 12, 22, 11]
print("Original List:", a)
for i in range(1, len(a)):
    key = a[i]
    j = i - 1
    while j >= 0 and a[j] > key:
        a[j + 1] = a[j]
        j -= 1
    a[j + 1] = key
print("Sorted List:", a)

# PRACTICAL 5(b): Bubble Sort

a = [64, 25, 12, 22, 11]
print("\nOriginal List:", a)
n = len(a)
for i in range(n):
    for j in range(0, n - i - 1):
        if a[j] > a[j + 1]:
            a[j], a[j + 1] = a[j + 1], a[j]
print("Sorted List:", a)

# PRACTICAL 5(c): Merge Sort

a = [64, 25, 12, 22, 11]
print("\nOriginal List:", a)
def merge_sort(a):
    if len(a) > 1:
        mid = len(a) // 2
        left, right = a[:mid], a[mid:]
        merge_sort(left)
        merge_sort(right)
        i = j = k = 0
        while i < len(left) and j < len(right):
            if left[i] < right[j]:
                a[k] = left[i]
                i += 1
            else:
                a[k] = right[j]
                j += 1
            k += 1
        while i < len(left):
            a[k] = left[i]
            i += 1
            k += 1
        while j < len(right):
            a[k] = right[j]
            j += 1
            k += 1
merge_sort(a)
print("Sorted List:", a)

# PRACTICAL 5(d): Quick Sort

a = [64, 25, 12, 22, 11]
print("\nOriginal List:", a)
def quick_sort(a):
    if len(a) <= 1:
        return a
    pivot = a[0]
    left = [x for x in a[1:] if x <= pivot]
    right = [x for x in a[1:] if x > pivot]
    return quick_sort(left) + [pivot] + quick_sort(right)
a = quick_sort(a)
print("Sorted List:", a)

# PRACTICAL 5(e): Selection Sort

a = [64, 25, 12, 22, 11]
print("\nOriginal List:", a)
n = len(a)
for i in range(n):
    min_index = i
    for j in range(i + 1, n):
        if a[j] < a[min_index]:
            min_index = j
    a[i], a[min_index] = a[min_index], a[i]
print("Sorted List:", a)
