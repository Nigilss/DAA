# Practical 8: Linear Search and Binary Search

# Linear Search
arr = [10, 20, 30, 40, 50]

search = int(input("Enter the element to search: "))
found = False

for i in range(len(arr)):
    if arr[i] == search:
        print("Element found at position:", i + 1)
        found = True
        break

if found == False:
    print("Element not found")


# Binary Search
arr = [10, 20, 30, 40, 50, 60, 70]

search = int(input("Enter the element to search: "))
low = 0
high = len(arr) - 1
found = False

while low <= high:
    mid = (low + high) // 2

    if arr[mid] == search:
        print("Element found at position:", mid + 1)
        found = True
        break
    elif search < arr[mid]:
        high = mid - 1
    else:
        low = mid + 1

if found == False:
    print("Element not found")
